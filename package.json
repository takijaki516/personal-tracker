{
  "name": "personal-tracker",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web",
    "android": "expo start --android",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:android": "expo export --platform android",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity error .",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json",
    "test": "vitest run",
    "desktop:compile": "node scripts/build-desktop.mjs",
    "mac": "npm run build && npm run desktop:compile && electron desktop-build/main.cjs",
    "mac:dev": "npm run desktop:compile && electron desktop-build/main.cjs --dev",
    "build:mac": "npm run build && npm run desktop:compile && electron-builder --mac",
    "android:native": "expo run:android",
    "build:apk": "expo run:android --variant release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "private": true,
  "type": "module",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "base64-js": "^1.5.1",
    "expo": "~57.0.22",
    "expo-background-task": "~57.0.17",
    "expo-camera": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-sqlite": "~57.0.3",
    "expo-task-manager": "~57.0.17",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "main": "index.ts",
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
